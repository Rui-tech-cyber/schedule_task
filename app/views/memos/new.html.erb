<h2>メモ新規作成</h2>

<%= form_with model: [@plan, @memo], local: true do |form| %>
  <% if @memo.errors.any? %>
    <div class="error-messages">
      <h3><%= pluralize(@memo.errors.count, "エラー") %>が発生しました:</h3>
      <ul>
        <% @memo.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :content, "メモ内容" %><br>
    <%= form.text_area :content, rows: 5 %>
  </div>

  <div>
    <%= form.submit "作成する" %>
  </div>
<% end %>