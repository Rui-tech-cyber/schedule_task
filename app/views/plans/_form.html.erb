<% if @plan.errors.any? %>
  <div class="alert alert-danger">
    <h4>エラーが発生しました：</h4>
    <ul>
      <% @plan.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @plan, local: true do |form| %>
  <div class="mb-3">
    <%= form.label :title %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :start_date %>
    <%= form.date_field :start_date, class: "form-control datepicker" %>
  </div>

  <div class="mb-3">
    <%= form.label :end_date %>
    <%= form.date_field :end_date, class: "form-control datepicker" %>
  </div>

  <div class="form-check mb-3">
    <%= form.label :all_day, class: "form-check-label" %>
    <%= form.check_box :all_day, class: "form-check-input" %>
  </div>

  <div class="mb-3">
    <%= form.label :memo %>
    <%= form.text_area :memo, rows: 4, class: "form-control" %>
  </div>

  <%= form.submit t('helpers.submit.create'), class: "btn btn-primary" %>
<% end %>
