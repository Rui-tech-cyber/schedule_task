<h1 class="mb-4">スケジュール詳細</h1>

<table class="table table-bordered">
  <tbody>
    <tr>
      <th>タイトル</th>
      <td><%= @plan.title %></td>
    </tr>
    <tr>
      <th>開始日</th>
      <td><%= @plan.start_date.strftime('%Y/%m/%d') %></td>
    </tr> 
    <tr>
      <th>終了日</th>
      <td><%= @plan.end_date.strftime('%Y/%m/%d') %></td>
    </tr> 
    <tr>
      <th>終日</th>
      <td><%= @plan.all_day? ? '◯' : '' %></td>
    </tr> 
    <tr>
      <th>メモ</th>
      <td><%= @plan.memo.present? ? @plan.memo : ' (なし) ' %></td>
    </tr> 
  </tbody>
</table>

<div class="mt-3">
  <%= link_to '一覧に戻る', plans_path, class: 'btn btn-secondary' %>
  <%= link_to '編集', edit_plan_path(@plan), class: 'btn btn-warning' %>
</div>